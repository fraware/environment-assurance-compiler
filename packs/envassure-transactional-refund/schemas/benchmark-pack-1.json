{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envassure.dev/schemas/benchmark-pack-1.json",
  "title": "EnvAssure Benchmark Pack Manifest",
  "description": "Schema for pack.yaml in EnvAssure research benchmark packs (format version 1). Distinct from Environment Pack (.eap) pack-manifest schemas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "version",
    "domain",
    "licenses",
    "permitted_uses",
    "sensitivity",
    "required_envassure",
    "required_ir",
    "connector_type",
    "public_components",
    "hidden_components",
    "probe_families",
    "metrics",
    "limitations",
    "maintainers",
    "governance_owner",
    "digests",
    "includes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1",
      "description": "Benchmark pack schema version."
    },
    "pack_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable pack identifier (kebab-case)."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Pack release version (semver-like)."
    },
    "name": {
      "type": "string",
      "description": "Human-readable pack title."
    },
    "description": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "permitted_uses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "research",
          "evaluation",
          "education",
          "benchmarking",
          "development"
        ]
      }
    },
    "sensitivity": {
      "type": "string",
      "enum": ["public", "internal", "restricted"]
    },
    "required_envassure": {
      "type": "string",
      "minLength": 1,
      "description": "Minimum envassure version constraint (PEP 440 / packaging)."
    },
    "required_ir": {
      "type": "string",
      "minLength": 1,
      "description": "Required Environment IR version."
    },
    "connector_type": {
      "type": "string",
      "enum": [
        "fixture_oracle",
        "in_memory",
        "http",
        "none"
      ]
    },
    "workflow_id": {
      "type": "string",
      "description": "Optional mapping to a concealed suite workflow id."
    },
    "public_components": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "hidden_components": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "probe_families": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "transition_agreement",
          "auth_agreement",
          "failure_agreement",
          "observation_agreement",
          "leakage",
          "solvability",
          "diff_match",
          "solve_rate",
          "verify_fpr"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "email": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "governance_owner": {
      "type": "string",
      "minLength": 1
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hidden_oracle"],
      "properties": {
        "hidden_oracle": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the concealed / hidden reference oracle."
        },
        "baseline_world": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pack_tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Optional digest over normalized public pack members."
        }
      }
    },
    "includes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_conflict",
        "open_ambiguity",
        "hidden_reference",
        "unsupported_uses",
        "baseline",
        "mutation_suite",
        "differential_plan"
      ],
      "properties": {
        "source_conflict": {
          "type": "string",
          "minLength": 1,
          "description": "Path relative to pack root."
        },
        "open_ambiguity": { "type": "string", "minLength": 1 },
        "hidden_reference": { "type": "string", "minLength": 1 },
        "unsupported_uses": { "type": "string", "minLength": 1 },
        "baseline": { "type": "string", "minLength": 1 },
        "mutation_suite": { "type": "string", "minLength": 1 },
        "differential_plan": { "type": "string", "minLength": 1 }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
