{
  "$defs": {
    "PackFileEntry": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "title": "PackFileEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "default": "1",
      "title": "Format Version",
      "type": "string"
    },
    "environment_id": {
      "title": "Environment Id",
      "type": "string"
    },
    "environment_version": {
      "title": "Environment Version",
      "type": "string"
    },
    "ir_version": {
      "default": "0.2.0",
      "title": "Ir Version",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/PackFileEntry"
      },
      "title": "Files",
      "type": "array"
    },
    "content_digest": {
      "default": "",
      "title": "Content Digest",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "environment_id",
    "environment_version",
    "created_at"
  ],
  "title": "PackManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envassure.dev/schemas/pack-manifest-1.json"
}
